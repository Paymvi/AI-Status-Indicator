# Claude Status runtime state (created at runtime in the install folder; never commit)
state/
position.txt
debug.on

# Generated binaries
*.exe
*.dll
*.pdb
bin/
obj/

# Temporary / log files
*.tmp
*.log

# Local Claude Code settings / backups (never commit your own settings)
settings.json
settings.local.json
settings.json.bak*
*.bak
*.bak-*
.claude/

# Environment / secrets files (not used by this project; never commit them)
.env
.env.*

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors
.vscode/
.idea/
*.swp
